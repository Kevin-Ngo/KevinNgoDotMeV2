---
import { getImage } from "astro:assets";
import FontCycle from "../components/FontCycle.astro";
import ResponsiveHero from "../components/ResponsiveHero.astro";
import SocialLinks from "../components/SocialLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { HeadingFont } from "../types/font-cycle";
import background from "../assets/background.jpg";
import heroMobile from "../assets/hero-mobile.jpg";
import heroMobilePlaceholder from "../assets/hero-mobile-placeholder.jpg?inline";
import heroWide from "../assets/hero-wide.jpg";
import heroWidePlaceholder from "../assets/hero-wide-placeholder.jpg?inline";

const title = "Kevin Ngô";
const description = "I yam Kevin";
const portraitAlt = `Picture of ${title}`;
const headingFonts = [
  { family: "UnifrakturCook", weight: 700 },
  { family: "Cinzel Decorative", weight: 700 },
  { family: "DotGothic16", weight: 400 },
  { family: "Nosifer", weight: 400 },
  { family: "UnifrakturMaguntia", weight: 400 },
  { family: "Danfo", weight: 400 },
  { family: "Raleway Dots", weight: 400 },
  { family: "Pirata One", weight: 400 },
  { family: "Press Start 2P", weight: 400 },
  { family: "Jacquard 12", weight: 400 },
  { family: "New Rocker", weight: 400 },
  { family: "Rubik Iso", weight: 400 },
] satisfies HeadingFont[];

const [mobileBackground, desktopBackground] = await Promise.all([
  getImage({ src: background, width: 1080, format: "webp" }),
  getImage({ src: background, width: 1920, format: "webp" }),
]);
---

<BaseLayout
  title={title}
  description={description}
  socialImageAlt={portraitAlt}
>
  <main
    class="home flex flex-col items-center px-[5vw] pt-12 pb-8 md:grid md:place-items-center md:px-0 md:py-0"
    style={`--background-mobile: url(${mobileBackground.src}); --background-desktop: url(${desktopBackground.src});`}
  >
    <div class="relative min-w-0 w-full md:-translate-y-70 lg:-translate-y-60">
      <FontCycle
        as="h1"
        fonts={headingFonts}
        cycleMs={125}
        batchSize={3}
        maximumFonts={12}
        class="mx-auto w-[85vw] text-center text-[clamp(2rem,10vw,3.25rem)] text-white lg:w-full lg:text-[10rem]"
      >
        {title}
      </FontCycle>
      <div class="mx-auto mt-8 w-[min(90vw,72rem)] md:absolute md:top-[calc(100%+3rem)] md:left-1/2 md:mt-0 md:-translate-x-1/2">
        <ResponsiveHero
          mobile={heroMobile}
          wide={heroWide}
          mobilePlaceholder={heroMobilePlaceholder}
          widePlaceholder={heroWidePlaceholder}
          alt={portraitAlt}
          class="mx-auto rounded-xl bg-[#8f7772] md:w-3/5"
          imageClass="sm:h-88 md:h-104"
        />
      </div>
    </div>
    <SocialLinks class="relative z-10 mt-8 flex w-[90%] items-center justify-center gap-3 text-center text-lg font-medium tracking-wide text-white sm:text-xl md:fixed md:bottom-8 md:left-1/2 md:mt-0 md:-translate-x-1/2" />
  </main>
</BaseLayout>
