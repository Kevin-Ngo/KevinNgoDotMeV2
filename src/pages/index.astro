---
import "../styles/global.css";

const title = "Kevin Ngô";
const description =
  "I yam Kevin";
const socialImage = new URL("/hero-1400.jpg", Astro.site);

const headingFontConfig = {
  debug: false,
  cycleMs: 125,
  batchSize: 3,
  maximumFonts: 12,
  fonts: [
    { family: "UnifrakturCook", weight: 700 },
    { family: "Cinzel Decorative", weight: 700 },
    { family: "DotGothic16", weight: 400 },
    { family: "Nosifer", weight: 400 },
    { family: "UnifrakturMaguntia", weight: 400 },
    { family: "Danfo", weight: 400 },
    { family: "Raleway Dots", weight: 400 },
    { family: "Pirata One", weight: 400 },
    { family: "Press Start 2P", weight: 400 },
    { family: "Jacquard 12", weight: 400 },
    { family: "New Rocker", weight: 400 },
    { family: "Rubik Iso", weight: 400 },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1400" />
    <meta property="og:image:height" content="1866" />
    <meta property="og:image:alt" content="Picture of Kevin Ngô" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Picture of Kevin Ngô" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/favicon.png?v=3" />
    <title>{title}</title>
  </head>
  <body>
    <main class="home flex flex-col items-center px-[5vw] pt-12 pb-8 md:grid md:place-items-center md:px-0 md:py-0">
      <div class="font-cycle-container md:-translate-y-70 lg:-translate-y-60">
        <h1
          class="font-cycle mx-auto w-[85vw] text-center text-[clamp(2rem,10vw,3.25rem)] text-white lg:w-full lg:text-[10rem]"
          data-font-cycle
          data-config={JSON.stringify(headingFontConfig)}
        >
          Kevin Ngô
        </h1>
        <div
          class="mx-auto mt-8 flex w-[min(90vw,72rem)] flex-col gap-8 md:absolute md:top-[calc(100%+3rem)] md:left-1/2 md:mt-0 md:-translate-x-1/2"
        >
          <div>
            <picture class="mx-auto block min-w-0 md:w-3/5">
              <source
                media="(min-width: 640px)"
                srcset="/hero-wide-800.jpg 800w, /hero-wide-1400.jpg 1400w"
                sizes="(min-width: 1280px) 691px, (min-width: 768px) 54vw, 90vw"
              />
              <img
                class="h-auto w-full rounded-xl object-cover sm:h-88 md:h-104"
                src="/hero-mobile-400.jpg"
                srcset="/hero-mobile-400.jpg 400w, /hero-mobile-800.jpg 800w"
                sizes="90vw"
                width="800"
                height="584"
                alt="Picture of Kevin Ngo"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
        </div>
        {
          headingFontConfig.debug && (
            <span class="font-cycle-debug" data-font-cycle-debug aria-hidden="true">
              Loading fonts...
            </span>
          )
        }
      </div>
      <div
        class="relative z-10 mt-8 flex w-[90%] items-center justify-center gap-3 text-center text-lg font-medium tracking-wide text-white sm:text-xl md:fixed md:bottom-8 md:left-1/2 md:mt-0 md:-translate-x-1/2"
      >
        <a
          class="transition-opacity hover:opacity-70"
          href="https://www.linkedin.com/in/kevinkkngo/"
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
        >
          <svg class="size-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.04H3.54V8.98H7.1v11.47ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
          </svg>
        </a>
        <a
          class="transition-opacity hover:opacity-70"
          href="https://github.com/Kevin-Ngo"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
        >
          <svg class="size-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
          </svg>
        </a>
        <a
          class="transition-opacity hover:opacity-70"
          href="https://www.instagram.com/kvngo/"
          target="_blank"
          rel="noreferrer"
          aria-label="Instagram"
        >
          <svg class="size-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.15-3.23 1.66-4.77 4.92-4.92C8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.63 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95C23.73 2.69 21.3.27 16.95.07 15.67.01 15.26 0 12 0Zm0 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z" />
          </svg>
        </a>
      </div>
    </main>

    <script>
      import "../scripts/font-cycle";
    </script>
  </body>
</html>
